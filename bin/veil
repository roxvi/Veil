#!/bin/sh

set -eu

usage() {
  printf '%s\n' \
    'Usage: veil clear|liquid [1-100|default]' \
    '       veil bg color [color|default]' \
    '       veil font family <name>' \
    '       veil font size <6-72>' \
    '       veil font weight <100-900|normal|bold>' \
    '       veil text [color|default]' \
    '       veil text antialias|bold|blink|ansi|bright-bold <on|off>' \
    '       veil bold text [color|default]' \
    '       veil selection [color|default]' \
    '       veil ansi normal|bright <black|red|green|yellow|blue|magenta|cyan|white> [color|default]' \
    '       veil dynamic colors <on|off>' \
    '       veil cursor style <block|underline|bar>' \
    '       veil cursor blink <on|off>' \
    '       veil cursor color [color|default]' \
    '       veil profile create|save|use|delete <name>' \
    '       veil profile <name>|list' \
    '       veil default [text]' \
    '       veil mac text' \
    '       veil image <path>' \
    '       veil pip [bound|unbound]' \
    '       veil reminders [list|lists|add|done|help]' \
    '       veil messages [chats|read|send|contacts|help]' \
    '       veil spotify [status|play|pause|toggle|next|previous|volume|help]'
}

fail_usage() { usage >&2; exit 2; }
[ "$#" -ge 1 ] || fail_usage

if [ "$1" = "pip" ]; then
  [ "$#" -le 2 ] || fail_usage
  case "${2:-bound}" in bound|unbound) ;; *) fail_usage ;; esac
  if [ "${TERM_PROGRAM:-}" != "Veil" ] || [ ! -t 1 ]; then
    printf '%s\n' 'veil pip: run this command at a prompt inside Veil.' >&2
    exit 1
  fi
  if [ "${2:-bound}" = unbound ]; then
    printf '\033]777;veil-pip;unbound\007'
  else
    printf '\033]777;veil-pip\007'
  fi
  exit 0
fi

# Keep the original names as aliases; route Contacts within Messages.
if [ "$1" = "messages" ] || [ "$1" = "imessage" ]; then
  shift
  if [ "${1:-}" = "contacts" ]; then
    shift
    set -- contacts "$@"
  else
    set -- imessage "$@"
  fi
fi

# Native integrations stay independent from appearance configuration.
case "$1" in
image|reminders|imessage|spotify|contacts)
  helper="veil-$1"
  if [ "$1" = "image" ]; then [ "$#" -eq 2 ] || fail_usage; fi
  script_path="$0"
  link_count=0
  while [ -L "$script_path" ]; do
    link_count=$((link_count + 1))
    if [ "$link_count" -gt 40 ]; then
      printf '%s\n' 'veil: too many command symlinks.' >&2
      exit 1
    fi
    link_target="$(readlink "$script_path")"
    case "$link_target" in
      /*) script_path="$link_target" ;;
      *) script_path="$(dirname -- "$script_path")/$link_target" ;;
    esac
  done
  script_dir="$(CDPATH= cd -- "$(dirname -- "$script_path")" && pwd)"
  if [ ! -x "${script_dir}/${helper}" ]; then
    printf 'veil: %s helper is missing from this installation.\n' "$helper" >&2
    exit 1
  fi
  shift
  exec "${script_dir}/${helper}" "$@"
  ;;
esac

config_root="${XDG_CONFIG_HOME:-${HOME}/.config}"
config_dir="${config_root}/veil"
config_path="${config_dir}/config"
profiles_dir="${config_dir}/profiles"
mkdir -p "$config_dir"
touch "$config_path"

default_text="#eef3ea"
default_glass_color="#14171c"
default_font_family="JetBrains Mono, SFMono-Regular, Menlo, monospace"
default_font_size="14"
default_font_weight="450"
default_bold_weight="700"
mac_font_family="SFMono-Regular, SF Mono, Menlo, monospace"

default_black="#1d2422"
default_red="#f08c86"
default_green="#79f26f"
default_yellow="#e8cb78"
default_blue="#86aee8"
default_magenta="#dba1e8"
default_cyan="#7ed3c4"
default_white="#eef3ea"
default_bright_black="#68706c"
default_bright_red="#f08c86"
default_bright_green="#79f26f"
default_bright_yellow="#e8cb78"
default_bright_blue="#86aee8"
default_bright_magenta="#dba1e8"
default_bright_cyan="#7ed3c4"
default_bright_white="#ffffff"

parse_color() {
  case "$1" in
    black) color="#000000" ;;
    white) color="#ffffff" ;;
    red) color="#ff5f57" ;;
    green|lime) color="#79f26f" ;;
    yellow) color="#ffd866" ;;
    blue) color="#61afef" ;;
    magenta|purple) color="#bd93f9" ;;
    cyan) color="#7ed3c4" ;;
    gray|grey) color="#a0a0a0" ;;
    orange) color="#ff9f43" ;;
    pink) color="#ff79c6" ;;
    *)
      hex="${1#\#}"
      if { [ "${#hex}" -ne 3 ] && [ "${#hex}" -ne 6 ]; }; then return 1; fi
      case "$hex" in *[!0-9A-Fa-f]*) return 1 ;; esac
      color="#${hex}"
      ;;
  esac
}

parse_toggle() {
  case "$1" in
    on|true|yes|1) toggle="true" ;;
    off|false|no|0) toggle="false" ;;
    *) return 1 ;;
  esac
}

validate_profile_name() {
  case "$1" in ''|.*|*..*|*/*|*[!A-Za-z0-9._-]*) return 1 ;; esac
  [ "${#1}" -le 64 ]
}

profile_command() {
  action="${2:-list}"
  case "$action" in
    list)
      [ "$#" -eq 2 ] || fail_usage
      mkdir -p "$profiles_dir"
      for path in "$profiles_dir"/*.config; do
        [ -f "$path" ] || continue
        basename "$path" .config
      done | sort
      exit 0
      ;;
    create|save|use|delete)
      [ "$#" -eq 3 ] || fail_usage
      name="$3"
      ;;
    *)
      [ "$#" -eq 2 ] || fail_usage
      action="use"
      name="$2"
      ;;
  esac
  if ! validate_profile_name "$name"; then
    printf '%s\n' 'Profile names may use letters, numbers, dot, underscore and hyphen (64 characters max).' >&2
    exit 2
  fi
  mkdir -p "$profiles_dir"
  profile_path="${profiles_dir}/${name}.config"
  case "$action" in
    create)
      if [ -e "$profile_path" ]; then printf 'Profile already exists: %s\n' "$name" >&2; exit 1; fi
      temporary="$(mktemp "${profiles_dir}/.profile.XXXXXX")"
      trap 'rm -f "$temporary"' EXIT HUP INT TERM
      cp "$config_path" "$temporary"
      mv "$temporary" "$profile_path"
      trap - EXIT HUP INT TERM
      printf 'Created profile %s.\n' "$name"
      ;;
    save)
      temporary="$(mktemp "${profiles_dir}/.profile.XXXXXX")"
      trap 'rm -f "$temporary"' EXIT HUP INT TERM
      cp "$config_path" "$temporary"
      mv "$temporary" "$profile_path"
      trap - EXIT HUP INT TERM
      printf 'Saved profile %s.\n' "$name"
      ;;
    use)
      if [ ! -f "$profile_path" ]; then printf 'Profile not found: %s\n' "$name" >&2; exit 1; fi
      temporary="$(mktemp "${config_dir}/.config.XXXXXX")"
      trap 'rm -f "$temporary"' EXIT HUP INT TERM
      cp "$profile_path" "$temporary"
      cp "$temporary" "$config_path"
      printf 'Loaded profile %s.\n' "$name"
      ;;
    delete)
      if [ ! -f "$profile_path" ]; then printf 'Profile not found: %s\n' "$name" >&2; exit 1; fi
      rm "$profile_path"
      printf 'Deleted profile %s.\n' "$name"
      ;;
  esac
  exit 0
}

if [ "$1" = "profile" ]; then profile_command "$@"; fi

operations="$(mktemp "${config_dir}/.operations.XXXXXX")"
temporary="$(mktemp "${config_dir}/.config.XXXXXX")"
trap 'rm -f "$operations" "$temporary"' EXIT HUP INT TERM

queue_raw() { printf '%s\t%s\n' "$1" "$2" >> "$operations"; }

queue_string() {
  case "$2" in *'
'*) printf '%s\n' 'Values cannot contain newlines.' >&2; exit 2 ;; esac
  escaped="$(printf '%s' "$2" | sed 's/\\/\\\\/g; s/"/\\"/g')"
  queue_raw "$1" "\"${escaped}\""
}

queue_color() {
  key="$1" requested="$2" fallback="$3"
  case "$requested" in
    default|deafault) queue_string "$key" "$fallback" ;;
    *)
      if ! parse_color "$requested"; then
        alpha="${requested#\#}"
        if [ "${4:-0}" != 1 ] || [ "${#alpha}" -ne 8 ]; then
          printf '%s\n' 'Color must be named, #RGB, #RRGGBB, or default.' >&2
          exit 2
        fi
        case "$alpha" in *[!0-9A-Fa-f]*) printf '%s\n' 'Color must be named, #RGB, #RRGGBB, or default.' >&2; exit 2 ;; esac
        color="#${alpha}"
      fi
      queue_string "$key" "$color"
      ;;
  esac
}

queue_text_defaults() {
  queue_string foreground "$default_text"
  queue_string bold-foreground "$default_text"
  queue_string font-family "$default_font_family"
  queue_raw font-size "$default_font_size"
  queue_raw font-weight "$default_font_weight"
  queue_raw font-bold-weight "$default_bold_weight"
}

queue_all_defaults() {
  queue_raw transparent true
  queue_raw clear-mode false
  queue_string glass-mode liquid
  queue_raw glass-opacity 0
  queue_string glass-color "$default_glass_color"
  queue_raw glass-blur 28
  queue_raw panel-opacity 0.28
  queue_text_defaults
  queue_raw line-height 1.18
  queue_raw text-antialias true
  queue_raw use-bold-font true
  queue_raw allow-blinking-text true
  queue_raw ansi-colors true
  queue_raw bright-bold false
  queue_raw dynamic-foreground true
  queue_string background "#080c0c"
  queue_string accent "#79f26f"
  queue_string border "#c7826d"
  queue_string selection "#5f745f88"
  queue_string cursor-color "#79f26f"
  queue_string cursor-style block
  queue_raw cursor-blink true
  queue_string black "$default_black"
  queue_string red "$default_red"
  queue_string green "$default_green"
  queue_string yellow "$default_yellow"
  queue_string blue "$default_blue"
  queue_string magenta "$default_magenta"
  queue_string cyan "$default_cyan"
  queue_string white "$default_white"
  queue_string bright-black "$default_bright_black"
  queue_string bright-red "$default_bright_red"
  queue_string bright-green "$default_bright_green"
  queue_string bright-yellow "$default_bright_yellow"
  queue_string bright-blue "$default_bright_blue"
  queue_string bright-magenta "$default_bright_magenta"
  queue_string bright-cyan "$default_bright_cyan"
  queue_string bright-white "$default_bright_white"
}

case "$1" in
  bg)
    { [ "$#" -eq 2 ] || [ "$#" -eq 3 ]; } && [ "$2" = color ] || fail_usage
    queue_color glass-color "${3-default}" "$default_glass_color"
    message="Background tint updated."
    ;;
  clear|liquid)
    [ "$#" -le 2 ] || fail_usage
    requested="${2:-default}"
    case "$requested" in
      default|deafault) opacity=0 ;;
      ''|*[!0-9]*) printf '%s\n' 'Transparency must be a whole number from 1 to 100, or default.' >&2; exit 2 ;;
      *)
        if ! awk -v value="$requested" 'BEGIN { exit value >= 1 && value <= 100 ? 0 : 1 }'; then
          printf '%s\n' 'Transparency must be a whole number from 1 to 100, or default.' >&2; exit 2
        fi
        opacity="$(awk -v transparency="$requested" 'BEGIN { printf "%.3f", 1 - (transparency / 100) }')"
        ;;
    esac
    queue_raw transparent true
    queue_raw glass-opacity "$opacity"
    if [ "$1" = clear ]; then
      queue_raw clear-mode true; queue_string glass-mode clear; queue_raw glass-blur 0
      message="Clear transparency updated."
    else
      queue_raw clear-mode false; queue_string glass-mode liquid; queue_raw glass-blur 28
      message="Liquid transparency updated."
    fi
    ;;
  font)
    [ "$#" -eq 3 ] || fail_usage
    case "$2" in
      family) [ -n "$3" ] || fail_usage; queue_string font-family "$3"; message="Font family set to $3." ;;
      size)
        if ! awk -v value="$3" 'BEGIN { exit value ~ /^[0-9]+([.][0-9]+)?$/ && value >= 6 && value <= 72 ? 0 : 1 }'; then
          printf '%s\n' 'Font size must be from 6 to 72.' >&2; exit 2
        fi
        queue_raw font-size "$3"; message="Font size set to $3."
        ;;
      weight)
        case "$3" in
          normal|bold) ;;
          *[!0-9]*|'') printf '%s\n' 'Font weight must be normal, bold, or 100-900.' >&2; exit 2 ;;
          *) [ "$3" -ge 100 ] && [ "$3" -le 900 ] || { printf '%s\n' 'Font weight must be normal, bold, or 100-900.' >&2; exit 2; } ;;
        esac
        queue_string font-weight "$3"; message="Font weight set to $3."
        ;;
      *) fail_usage ;;
    esac
    ;;
  text)
    if [ "$#" -le 2 ]; then
      queue_color foreground "${2:-default}" "$default_text"
      case "${2:-default}" in default|deafault) queue_text_defaults ;; esac
      message="Text color updated."
    else
      [ "$#" -eq 3 ] || fail_usage
      if ! parse_toggle "$3"; then printf '%s\n' 'Text toggles accept on or off.' >&2; exit 2; fi
      case "$2" in
        antialias) key=text-antialias ;;
        bold) key=use-bold-font ;;
        blink) key=allow-blinking-text ;;
        ansi) key=ansi-colors ;;
        bright-bold) key=bright-bold ;;
        *) fail_usage ;;
      esac
      queue_raw "$key" "$toggle"; message="Text $2 set to $toggle."
    fi
    ;;
  bold)
    { [ "$#" -eq 2 ] || [ "$#" -eq 3 ]; } && [ "$2" = text ] || fail_usage
    queue_color bold-foreground "${3:-default}" "$default_text"; message="Bold text color updated."
    ;;
  selection)
    [ "$#" -le 2 ] || fail_usage
    queue_color selection "${2:-default}" "#5f745f88" 1; message="Selection color updated."
    ;;
  ansi)
    [ "$#" -eq 4 ] || fail_usage
    palette="$2" color_name="$3" requested="$4"
    case "$color_name" in black|red|green|yellow|blue|magenta|cyan|white) ;; *) fail_usage ;; esac
    case "$palette" in
      normal) key="$color_name"; eval fallback="\$default_${color_name}" ;;
      bright) key="bright-$color_name"; eval fallback="\$default_bright_${color_name}" ;;
      *) fail_usage ;;
    esac
    queue_color "$key" "$requested" "$fallback"; message="ANSI $palette $color_name updated."
    ;;
  dynamic)
    [ "$#" -eq 3 ] && [ "$2" = colors ] || fail_usage
    if ! parse_toggle "$3"; then printf '%s\n' 'Dynamic colors accepts on or off.' >&2; exit 2; fi
    queue_raw dynamic-foreground "$toggle"; message="Dynamic foreground colors set to $toggle."
    ;;
  cursor)
    [ "$#" -le 3 ] || fail_usage
    case "${2:-}" in
      style)
        [ "$#" -eq 3 ] || fail_usage
        case "$3" in block|underline|bar) ;; *) printf '%s\n' 'Cursor style must be block, underline, or bar.' >&2; exit 2 ;; esac
        queue_string cursor-style "$3"; message="Cursor style set to $3."
        ;;
      blink)
        [ "$#" -eq 3 ] || fail_usage
        if ! parse_toggle "$3"; then printf '%s\n' 'Cursor blink accepts on or off.' >&2; exit 2; fi
        queue_raw cursor-blink "$toggle"; message="Cursor blink set to $toggle."
        ;;
      color)
        { [ "$#" -eq 2 ] || [ "$#" -eq 3 ]; } || fail_usage
        queue_color cursor-color "${3:-default}" "#79f26f"; message="Cursor color updated."
        ;;
      *) fail_usage ;;
    esac
    ;;
  default|deafault)
    [ "$#" -le 2 ] || fail_usage
    if [ "$#" -eq 2 ]; then
      [ "$2" = text ] || fail_usage
      queue_text_defaults; message="Text restored to the original Veil default."
    else
      queue_all_defaults; message="Every Veil appearance setting restored to default."
    fi
    ;;
  mac)
    [ "$#" -eq 2 ] && [ "$2" = text ] || fail_usage
    queue_string foreground "$default_text"
    queue_string bold-foreground "$default_text"
    queue_string font-family "$mac_font_family"
    queue_raw font-size 11
    queue_raw font-weight 400
    queue_raw font-bold-weight 700
    message="Text set to SF Mono Regular 11."
    ;;
  *) fail_usage ;;
esac

# Apply each command with one rewrite, collapsing duplicate keys. This avoids
# exposing half-applied resets and profile changes to the live renderer.
awk -F '\t' '
  NR == FNR { values[$1] = $2; order[++count] = $1; next }
  {
    line = $0
    key = line
    sub(/^[[:space:]]*/, "", key)
    sub(/[[:space:]]*=.*/, "", key)
    if (key in values) {
      if (!(key in seen)) {
        print key " = " values[key]
        seen[key] = 1
      }
      next
    }
    print line
  }
  END {
    for (position = 1; position <= count; position++) {
      key = order[position]
      if (!(key in seen)) {
        print key " = " values[key]
        seen[key] = 1
      }
    }
  }
' "$operations" "$config_path" > "$temporary"
cp "$temporary" "$config_path"
printf '%s\n' "$message"
